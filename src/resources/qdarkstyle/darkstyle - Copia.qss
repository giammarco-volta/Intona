* {
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 10pt;
    color: #d6d6d6;
}

QWidget {
    background-color: #2f302f;
}

QFrame {
    background-color: #363736;
    border: 1px solid #202120;
    border-radius: 3px;
}

QGroupBox {
    background-color: #363736;
    border: 1px solid #202120;
    border-radius: 3px;
    margin-top: 12px;
    padding-top: 14px;
}

QGroupBox::title {
    color: #f39a21;
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    padding: 0 4px;
}

QLabel {
    background: transparent;
    color: #d0d0d0;
}

QLineEdit {
    background-color: #242524;
    border: 1px solid #555;
    border-top-color: #151515;
    border-left-color: #151515;
    border-radius: 3px;
    padding: 2px 5px;
    selection-background-color: #f39a21;
}

QLineEdit:focus {
    border: 1px solid #f39a21;
}

QPushButton {
    background-color: #3b3c3b;
    border: 1px solid #1f201f;
    border-radius: 3px;
    padding: 4px 8px;
}

QPushButton:hover {
    background-color: #454645;
}

QPushButton:pressed {
    background-color: #252625;
}

QSlider::groove:horizontal {
    height: 4px;
    background: #5a5b5a;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: #5a5b5a;
    border-radius: 2px;
}

QSlider::add-page:horizontal {
    background: #5a5b5a;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #f0a000;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background: #ffb22a;
}
